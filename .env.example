# ==============================================================================
# EXPLORELY — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in your specific values:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULE FOR REACT (FRONTEND):
# Any variable starting with "REACT_APP_" is bundled into the client-side JavaScript!
# Anyone visiting your website can see them in DevTools / page source.
# NEVER put private backend secrets here (e.g., DB passwords, Stripe secret keys, JWT secrets).
# ==============================================================================

# Application Port (Development Server)
PORT=3000

# Application Name
REACT_APP_NAME=Explorely

# Optional: External Backend API URL (when connecting a backend)
# REACT_APP_API_URL=http://localhost:5000/api

# Optional: Google Maps Platform API Key (Restricted to your domain/localhost in Google Cloud Console)
# REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Weather / Tourism Data API Key (if integrated in future)
# REACT_APP_WEATHER_API_KEY=your_weather_api_key_here
